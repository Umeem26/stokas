# Salin menjadi .env lalu isi. File .env ikut dibundel sebagai asset aplikasi
# (di web bisa diunduh siapa saja), jadi isinya HARUS aman untuk publik.
#
# SUPABASE_ANON_KEY: gunakan HANYA kunci publishable (sb_publishable_...) atau
# JWT anon lama. JANGAN PERNAH pakai kunci rahasia (sb_secret_...) atau JWT
# service_role: kunci itu menembus RLS. Aplikasi menolaknya saat mulai.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
